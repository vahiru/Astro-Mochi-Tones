---
import themeConfig from "astro-mochi-tones:config";

const year = new Date().getFullYear();
const siteTitle = themeConfig.title;
const author = themeConfig.author || siteTitle;
const { footer } = themeConfig;
const slogan = footer.slogan || themeConfig.description || "";
const copyright = footer.copyrightTemplate
  .replaceAll("{year}", String(year))
  .replaceAll("{author}", author)
  .replaceAll("{title}", siteTitle);
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-mark" aria-hidden="true">V</span>
      <div>
        <strong class="brand-name">{siteTitle}</strong>
        {slogan && <p class="brand-slogan">{slogan}</p>}
      </div>
    </div>

    {footer.links.length > 0 && (
      <nav class="footer-nav" aria-label={footer.socialTitle}>
        <span class="nav-title label-medium">{footer.socialTitle}</span>
        <ul class="nav-list">
          {footer.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
                {link.external && <md-icon aria-hidden="true">north_east</md-icon>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="footer-bottom">
      <span>{copyright}</span>
      {footer.showThemeCredit && (
        <span class="theme-credit">
          {footer.themeCreditLabel}{" "}
          <a href={footer.themeCreditHref} target="_blank" rel="noopener noreferrer">
            {footer.themeCreditText}
          </a>
        </span>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 72px;
    border-top: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface-container-low);
    color: var(--md-sys-color-on-surface);
  }

  .footer-inner {
    display: grid;
    width: min(100%, 1376px);
    margin: 0 auto;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 36px 64px;
    padding: 40px clamp(24px, 4vw, 56px) 28px;
  }

  .footer-brand {
    display: flex;
    max-width: 620px;
    align-items: flex-start;
    gap: 16px;
  }

  .footer-mark {
    display: grid;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    place-items: center;
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    font-family: var(--md-ref-typeface-brand);
    font-size: 22px;
    font-weight: 700;
  }

  .brand-name {
    display: block;
    font-size: var(--md-sys-typescale-title-large-size);
    line-height: var(--md-sys-typescale-title-large-line-height);
  }

  .brand-slogan {
    margin: 6px 0 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: var(--md-sys-typescale-body-medium-line-height);
  }

  .footer-nav {
    min-width: 240px;
  }

  .nav-title {
    display: block;
    margin-bottom: 12px;
    color: var(--md-sys-color-primary);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    display: inline-flex;
    min-height: var(--md-sys-touch-target-size);
    align-items: center;
    gap: 5px;
    padding: 0 14px;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-full);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: 600;
    transition:
      background-color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
  }

  .nav-list a:hover {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .nav-list md-icon {
    width: 16px;
    height: 16px;
    flex-basis: 16px;
    font-size: 16px;
  }

  .footer-bottom {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--md-sys-color-outline-variant);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-small-size);
  }

  .theme-credit a {
    color: var(--md-sys-color-primary);
    font-weight: 700;
  }

  @media (max-width: 839px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 599px) {
    .site-footer {
      margin-top: 56px;
    }

    .footer-inner {
      gap: 28px;
      padding: 32px 20px 24px;
    }
  }
</style>
