---
// src/components/Waline.astro
import themeConfig from 'astro-mochi-tones:config';
import '@waline/client/waline.css';

const serverURL = themeConfig.waline?.serverURL;
const walineConfig = themeConfig.waline;
---

{serverURL && (
  <div
    id="waline"
    data-server-url={serverURL}
    data-pageview={String(walineConfig?.pageview ?? true)}
    data-comment={String(walineConfig?.comment ?? true)}
    data-dark={walineConfig?.dark ?? "html.dark"}
    data-emojis={JSON.stringify(walineConfig?.emojis ?? [])}
  />
)}

{serverURL && <script>
  import { init, type WalineEmojiPresets } from '@waline/client';

  const container = document.getElementById('waline');
  const serverURL = container?.dataset.serverUrl;
  let emojis: WalineEmojiPresets[] = [];
  try {
    const parsed: unknown = JSON.parse(container?.dataset.emojis || '[]');
    if (Array.isArray(parsed)) {
      emojis = parsed.filter(
        (value): value is `https://${string}` =>
          typeof value === 'string' && value.startsWith('https://'),
      );
    }
  } catch {
    emojis = [];
  }

  if (!container || !serverURL) {
    throw new Error('Waline serverURL is missing.');
  }

  init({
    el: container,
    serverURL,
    pageview: container.dataset.pageview === 'true', 
    comment: container.dataset.comment === 'true',
    emoji: emojis,
    dark: container.dataset.dark || 'html.dark',
  });
</script>}

<style is:global>
  :root {
    --waline-theme-color: var(--md-sys-color-primary) !important;
    --waline-active-color: var(--md-sys-color-primary) !important;
    --waline-color: var(--md-sys-color-on-surface) !important;
    --waline-info-color: var(--md-sys-color-on-surface-variant) !important;
    --waline-bgcolor: var(--md-sys-color-surface) !important;
    --waline-bgcolor-light: var(--md-sys-color-surface-container) !important;
    --waline-border-color: var(--md-sys-color-outline-variant) !important;
    --waline-disable-bgcolor: var(--md-sys-color-surface-container-highest) !important;
    --waline-disable-color: var(--md-sys-color-on-surface-variant) !important;
    --waline-code-bgcolor: var(--md-sys-color-surface-container-high) !important;
    --waline-bq-color: var(--md-sys-color-surface-container) !important;
    --waline-avatar-radius: var(--md-sys-shape-corner-full) !important;
    --waline-box-shadow: var(--md-sys-elevation-level1) !important;
    --waline-font-size: var(--md-sys-typescale-body-large-size) !important;
  }

  #waline {
    max-width: 100%;
    margin-block-start: 48px;
    color: var(--md-sys-color-on-surface);
    font-family: var(--md-ref-typeface-plain);
  }

  #waline .wl-panel {
    margin: 0 !important;
    border: 1px solid var(--md-sys-color-outline-variant) !important;
    border-radius: var(--md-sys-shape-corner-extra-large) !important;
    background: var(--md-sys-color-surface-container-low) !important;
    overflow: hidden;
    transition:
      border-radius var(--md-sys-motion-duration-default) var(--md-sys-motion-easing-spatial),
      box-shadow var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
  }

  #waline .wl-header {
    display: flex;
    flex-wrap: wrap;
    padding: 8px 16px !important;
    border-bottom: 1px solid var(--md-sys-color-outline-variant) !important;
    background: var(--md-sys-color-surface-container) !important;
  }

  #waline .wl-header .wl-item {
    min-width: min(100%, 160px);
    flex: 1 1 160px;
    border-bottom: 0 !important;
  }

  #waline .wl-header label {
    color: var(--md-sys-color-primary) !important;
    font-size: var(--md-sys-typescale-label-medium-size);
    font-weight: 650;
    letter-spacing: var(--md-sys-typescale-label-medium-tracking);
  }

  #waline input,
  #waline textarea,
  #waline button {
    font-family: inherit;
  }

  #waline .wl-header input {
    min-height: var(--md-sys-touch-target-size);
    background: transparent !important;
    color: var(--md-sys-color-on-surface) !important;
  }

  #waline .wl-editor {
    width: 100% !important;
    min-height: 136px !important;
    padding: 20px !important;
    background: transparent !important;
    color: var(--md-sys-color-on-surface) !important;
    font-size: var(--md-sys-typescale-body-large-size) !important;
    line-height: var(--md-sys-typescale-body-large-line-height) !important;
    resize: vertical;
  }

  #waline .wl-header input:focus-visible,
  #waline .wl-editor:focus-visible,
  #waline .wl-btn:focus-visible {
    border-radius: var(--md-sys-shape-corner-small);
    outline: var(--md-sys-focus-ring-width) solid var(--md-sys-focus-ring-color) !important;
    outline-offset: calc(-1 * var(--md-sys-focus-ring-width)) !important;
  }

  #waline .wl-footer {
    margin-top: 0 !important;
    padding: 12px 16px !important;
    border-top: 1px solid var(--md-sys-color-outline-variant) !important;
    background: var(--md-sys-color-surface-container) !important;
  }

  #waline .wl-btn {
    min-height: var(--md-sys-touch-target-size) !important;
    padding: 0 24px !important;
    border-radius: var(--md-sys-shape-corner-full) !important;
    font-size: var(--md-sys-typescale-label-large-size) !important;
    font-weight: 650 !important;
    letter-spacing: var(--md-sys-typescale-label-large-tracking) !important;
    line-height: var(--md-sys-typescale-label-large-line-height) !important;
    transition:
      box-shadow var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      translate var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-spatial);
  }

  #waline .wl-btn.primary {
    border: 0 !important;
    background: var(--md-sys-color-primary) !important;
    color: var(--md-sys-color-on-primary) !important;
  }

  #waline .wl-btn:active {
    translate: 0 1px;
  }

  #waline .wl-cards .wl-card {
    margin-top: 0 !important;
    padding: 24px 0 !important;
    border-bottom: 1px solid var(--md-sys-color-outline-variant) !important;
  }

  #waline .wl-avatar {
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-full) !important;
    background: var(--md-sys-color-surface-container-high);
  }

  #waline .wl-content {
    color: var(--md-sys-color-on-surface) !important;
    font-size: var(--md-sys-typescale-body-large-size) !important;
    letter-spacing: var(--md-sys-typescale-body-large-tracking) !important;
    line-height: var(--md-sys-typescale-body-large-line-height) !important;
  }

  #waline .wl-quote {
    border-inline-start: 4px solid var(--md-sys-color-primary) !important;
    border-radius: var(--md-sys-shape-corner-medium) !important;
    background: var(--md-sys-color-surface-container-high) !important;
    color: var(--md-sys-color-on-surface-variant) !important;
  }

  #waline a {
    color: var(--md-sys-color-primary);
  }

  @media (hover: hover) {
    #waline .wl-panel:hover {
      border-radius: var(--md-sys-shape-corner-extra-large-increased) !important;
      box-shadow: var(--md-sys-elevation-level1);
    }

    #waline .wl-btn.primary:hover {
      box-shadow: var(--md-sys-elevation-level1);
      translate: 0 -1px;
    }
  }

  @media (max-width: 599px) {
    #waline .wl-panel,
    #waline .wl-panel:hover {
      border-radius: var(--md-sys-shape-corner-large) !important;
    }

    #waline .wl-header .wl-item {
      flex-basis: 100%;
    }

    #waline .wl-editor {
      padding: 16px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #waline .wl-panel,
    #waline .wl-btn {
      transition: none;
    }
  }
</style>
