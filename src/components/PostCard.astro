---
// src/components/PostCard.astro
import type { CollectionEntry } from 'astro:content';
import themeConfig from 'astro-mochi-tones:config';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

// ============================================================
// 🛑 核心修复逻辑：手动强制转换日期
// ============================================================
let dateObj;

// 1. 尝试把数据转成 Date 对象
try {
    // 如果本来就是 Date，直接用；如果是字符串，new Date() 转一下
    dateObj = new Date(post.data.date);
} catch (e) {
    // 如果转换失败，给个当前时间兜底，防止页面崩溃
    dateObj = new Date(); 
}

// 2. 再次检查是否有效 (处理 Invalid Date 情况)
if (isNaN(dateObj.getTime())) {
    dateObj = new Date(); // 还是不行？那就给个默认值
}

// 3. 格式化日期
const dateStr = dateObj.toLocaleDateString(themeConfig.lang, {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});
// ============================================================

// 颜色生成逻辑 (保持不变)
const themes = [
  { bg: 'var(--md-sys-color-primary-container)', color: 'var(--md-sys-color-on-primary-container)' },
  { bg: 'var(--md-sys-color-secondary-container)', color: 'var(--md-sys-color-on-secondary-container)' },
  { bg: 'var(--md-sys-color-tertiary-container)', color: 'var(--md-sys-color-on-tertiary-container)' },
  { bg: 'var(--md-sys-color-error-container)', color: 'var(--md-sys-color-on-error-container)' },
];
const titleStr = post.data.title || themeConfig.labels.untitled; // 防止标题为空
const index = titleStr.split("").reduce((acc, char) => acc + char.charCodeAt(0), 0) % themes.length;
const theme = themes[index];
---

<a href={`/blog/${post.slug}`} class={`blog-card ${featured ? 'featured' : ''}`}>
  <div class="card-image-container">
    {post.data.cover ? (
      <img src={post.data.cover} alt={post.data.title} class="card-image" />
    ) : (
      <div class="placeholder-bg" style={`background-color: ${theme.bg}; color: ${theme.color};`}>
        {post.data.categories && post.data.categories.length > 0 ? (
             <span style="font-size: 4rem; font-weight: bold; opacity: 0.5;">{post.data.categories[0][0]}</span>
        ) : (
             <span class="material-symbols-rounded" style="font-size: 64px; font-weight: 300;">auto_stories</span>
        )}
      </div>
    )}
  </div>

  <div class="content">
    {featured && <span class="label-medium featured-badge">Featured Post</span>}
    <h3 class="title-large headline">{post.data.title || themeConfig.labels.untitled}</h3>
    
    {featured && post.data.description && (
        <p class="body-medium description">{post.data.description}</p>
    )}

    <div class="meta-row">
        <span class="label-medium date">{dateStr}</span>
        
        {post.data.categories && post.data.categories.length > 0 && (
            <span class="label-small category-badge">{post.data.categories[0]}</span>
        )}
    </div>
  </div>
  
  <md-ripple></md-ripple>
</a>

<script>
  import '@material/web/ripple/ripple.js';
</script>

<style>
  .blog-card {
    display: flex; flex-direction: column; position: relative;
    background-color: var(--md-sys-color-surface-container-low);
    border-radius: 28px; overflow: hidden; height: 100%;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.2s;
    text-decoration: none; color: inherit;
    box-shadow: var(--md-sys-elevation-level1);
  }
  .blog-card:hover { 
    transform: translateY(-4px); 
    box-shadow: var(--md-sys-elevation-level2);
    background-color: var(--md-sys-color-surface-container-high);
  }

  .featured-badge {
    color: var(--md-sys-color-primary);
    margin-bottom: 0.5rem;
    display: block;
  }

  .card-image-container {
    height: 220px; width: 100%; position: relative; overflow: hidden;
    background-color: var(--md-sys-color-surface-variant);
  }
  .card-image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .placeholder-bg {
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  }

  .content { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; }
  .headline { margin: 0 0 1rem 0; color: var(--md-sys-color-on-surface); }
  
  .description {
      color: var(--md-sys-color-on-surface-variant);
      margin-bottom: 1.5rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
  }

  .meta-row {
      margin-top: auto;
      display: flex; align-items: center;
      justify-content: space-between;
      color: var(--md-sys-color-on-surface-variant);
  }
  
  .category-badge {
      background-color: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
      padding: 4px 12px; border-radius: 8px;
  }

  /* Featured Post Layout (Desktop) */
  @media (min-width: 840px) {
    .blog-card.featured {
        flex-direction: row;
        min-height: 320px;
    }
    .blog-card.featured .card-image-container {
        width: 45%;
        height: auto;
    }
    .blog-card.featured .content {
        width: 55%;
        padding: 2.5rem;
    }
    .blog-card.featured .headline {
        font-size: var(--md-sys-typescale-headline-small-size);
        line-height: var(--md-sys-typescale-headline-small-line-height);
    }
  }
</style>
