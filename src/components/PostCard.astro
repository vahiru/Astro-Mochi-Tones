---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import themeConfig from "astro-mochi-tones:config";
import { isLocalAsset, resolveImage } from "../utils/images";

interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
  /**
   * 卡片图片在宽屏（≥1100px 视口）下的显示宽度，用于生成 `sizes`。
   * 组件本身看不到自己所处的栅格，所以由调用方按实际布局给出：
   * 首页两栏约 400px，归档约 524px，分类/标签约 548px。默认取偏大的一档。
   */
  mediaWidth?: number;
}

const { post, featured = false, mediaWidth = 560 } = Astro.props;
const date = post.data.date instanceof Date ? post.data.date : new Date(post.data.date);
const validDate = !Number.isNaN(date.valueOf());
const dateLabel = validDate
  ? new Intl.DateTimeFormat(themeConfig.lang, {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(date)
  : themeConfig.labels.noDate;

const themes = [
  { background: "var(--md-sys-color-primary-container)", foreground: "var(--md-sys-color-on-primary-container)" },
  { background: "var(--md-sys-color-secondary-container)", foreground: "var(--md-sys-color-on-secondary-container)" },
  { background: "var(--md-sys-color-tertiary-container)", foreground: "var(--md-sys-color-on-tertiary-container)" },
  { background: "var(--md-sys-color-error-container)", foreground: "var(--md-sys-color-on-error-container)" },
];
const title = post.data.title || themeConfig.labels.untitled;
const themeIndex = [...title].reduce((sum, character) => sum + (character.codePointAt(0) ?? 0), 0) % themes.length;
const cardTheme = themes[themeIndex];
const postSlug = "slug" in post && typeof post.slug === "string"
  ? post.slug
  : post.id.replace(/\.(md|mdx)$/i, "");
const category = post.data.categories?.[0];
const placeholderLabel = category?.trim().charAt(0) || "auto_stories";

/*
 * 缩略图的 sizes 按浏览器里实测的渲染尺寸标定。注意 object-fit: cover 需要的是
 * 裁切后的源图宽度，不等于图框宽度：
 *
 *   普通卡片  <600px 视口：120×109 图框 → 需 ~145px
 *             ≥600px 视口：改为上下堆叠，图片占满卡片宽度
 *                          首页 393×184、归档 524×184、分类/标签 548×184
 *   精选卡片  1440 视口：355×338 图框（16:9 源图）→ 需 ~613px
 *             480  视口：446×278 → 需 ~504px
 *
 * 命中 src/assets/images/ 的封面走 astro:assets 生成多尺寸 WebP，
 * 仍放在 public/ 或使用外链的封面退回普通 <img>。
 */
const cover = await resolveImage(post.data.cover);
const coverWidths = featured
  ? [480, 600, 900, 1200, 1600]
  : [160, 320, 480, 640, 800, 1120];
const coverSizes = featured
  ? "(min-width: 1100px) 600px, (min-width: 840px) 42vw, (min-width: 700px) 80vw, 100vw"
  : `(max-width: 599px) 160px, (max-width: 1099px) 42vw, ${mediaWidth}px`;
---

<a
  href={`/blog/${postSlug}`}
  class:list={["blog-card", { featured }]}
  aria-label={`阅读文章：${title}`}
>
  <div class="card-media">
    {
      isLocalAsset(cover) ? (
        <Image
          src={cover}
          alt=""
          class="card-image"
          widths={coverWidths}
          sizes={coverSizes}
          format="webp"
          loading={featured ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={featured ? "high" : "auto"}
        />
      ) : cover ? (
        <img
          src={cover}
          alt=""
          class="card-image"
          loading={featured ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={featured ? "high" : "auto"}
          referrerpolicy="no-referrer"
        />
      ) : (
        <div
          class="placeholder"
          style={`--placeholder-bg: ${cardTheme.background}; --placeholder-fg: ${cardTheme.foreground}`}
          aria-hidden="true"
        >
          {category ? (
            <span class="placeholder-letter">{placeholderLabel}</span>
          ) : (
            <md-icon class="placeholder-icon">{placeholderLabel}</md-icon>
          )}
        </div>
      )
    }
  </div>

  <div class="card-content">
    {featured && (
      <span class="featured-badge label-medium">
        <md-icon aria-hidden="true">auto_awesome</md-icon>
        精选文章
      </span>
    )}

    <h3 class="card-title">{title}</h3>

    {featured && post.data.description && (
      <p class="card-description body-medium">{post.data.description}</p>
    )}

    <div class="meta-row">
      <time class="date label-medium" datetime={validDate ? date.toISOString() : undefined}>{dateLabel}</time>
      {category && <span class="category-badge label-small">{category}</span>}
    </div>
  </div>

  <md-ripple></md-ripple>
</a>

<script>
  import "@material/web/ripple/ripple.js";
</script>

<style>
  .blog-card {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 128px;
    grid-template-columns: 120px minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--md-sys-shape-corner-large-increased);
    background: var(--md-sys-color-surface-container-low);
    color: var(--md-sys-color-on-surface);
    transition:
      background-color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      border-radius var(--md-sys-motion-duration-default) var(--md-sys-motion-easing-spatial),
      box-shadow var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      translate var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-spatial);
  }

  .blog-card.featured {
    grid-template-columns: 1fr;
    border-radius: var(--md-sys-shape-corner-extra-large);
    background: var(--md-sys-color-surface-container);
  }

  .card-media {
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    background: var(--md-sys-color-surface-variant);
  }

  .blog-card.featured .card-media {
    height: clamp(210px, 58vw, 300px);
  }

  .card-image,
  .placeholder {
    width: 100%;
    height: 100%;
  }

  .card-image {
    display: block;
    object-fit: cover;
    transition: scale var(--md-sys-motion-duration-slow) var(--md-sys-motion-easing-spatial);
  }

  .placeholder {
    display: grid;
    place-items: center;
    background: var(--placeholder-bg);
    color: var(--placeholder-fg);
  }

  .placeholder-letter {
    font-family: var(--md-ref-typeface-brand);
    font-size: clamp(44px, 9vw, 72px);
    font-weight: 650;
    opacity: 0.58;
  }

  .placeholder-icon {
    width: 64px;
    height: 64px;
    font-size: 64px;
    opacity: 0.58;
  }

  .card-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 16px;
  }

  .blog-card.featured .card-content {
    padding: 24px;
  }

  .featured-badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    padding: 5px 10px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    font-weight: 700;
  }

  .featured-badge md-icon {
    width: 18px;
    height: 18px;
    flex-basis: 18px;
    font-size: 18px;
  }

  .card-title {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: 650;
    line-height: var(--md-sys-typescale-title-medium-line-height);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .blog-card.featured .card-title {
    font-family: var(--md-ref-typeface-brand);
    font-size: var(--md-sys-typescale-headline-small-size);
    font-weight: 500;
    line-height: var(--md-sys-typescale-headline-small-line-height);
  }

  .card-description {
    display: -webkit-box;
    margin: 14px 0 20px;
    overflow: hidden;
    color: var(--md-sys-color-on-surface-variant);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .meta-row {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 12px;
    color: var(--md-sys-color-on-surface-variant);
  }

  .date {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-badge {
    flex: 0 0 auto;
    padding: 4px 10px;
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  @media (hover: hover) {
    .blog-card:hover {
      border-color: var(--md-sys-color-outline-variant);
      border-radius: var(--md-sys-shape-corner-extra-large);
      background: var(--md-sys-color-surface-container-high);
      box-shadow: var(--md-sys-elevation-level1);
      translate: 0 -3px;
    }

    .blog-card:hover .card-image {
      scale: 1.035;
    }
  }

  @media (min-width: 600px) {
    .blog-card:not(.featured) {
      min-height: 330px;
      grid-template-columns: 1fr;
    }

    .blog-card:not(.featured) .card-media {
      height: 184px;
    }

    .blog-card:not(.featured) .card-content {
      min-height: 144px;
      padding: 20px;
    }
  }

  @media (min-width: 840px) {
    .blog-card.featured {
      min-height: 340px;
      grid-template-columns: minmax(280px, 44%) minmax(0, 1fr);
    }

    .blog-card.featured .card-media {
      height: auto;
    }

    .blog-card.featured .card-content {
      justify-content: center;
      padding: clamp(28px, 4vw, 44px);
    }

    .blog-card.featured .card-title {
      font-size: var(--md-sys-typescale-headline-medium-size);
      line-height: var(--md-sys-typescale-headline-medium-line-height);
    }
  }
</style>
