---
import "@material/web/icon/icon.js";

interface Props {
  title?: string;
  open?: boolean;
  color?: "default" | "red" | "orange" | "yellow" | "green" | "cyan" | "blue" | "purple";
}

const { title = "Details", open = false, color = "default" } = Astro.props;
const toneMap: Record<string, string> = {
  default: "primary",
  red: "error",
  orange: "warning",
  yellow: "warning",
  green: "success",
  cyan: "info",
  blue: "info",
  purple: "primary",
};
const tone = toneMap[color] ?? "primary";
---

<details class={`folding-box tone-${tone}`} open={open}>
  <summary>
    <span class="summary-icon" aria-hidden="true"><md-icon>unfold_more</md-icon></span>
    <span class="title title-small">{title}</span>
    <md-icon class="arrow" aria-hidden="true">expand_more</md-icon>
  </summary>
  <div class="content"><slot /></div>
</details>

<style>
  .folding-box {
    --folding-accent: var(--md-sys-color-primary);
    --folding-on-accent: var(--md-sys-color-on-primary);
    margin: 20px 0;
    overflow: hidden;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large-increased);
    background: var(--md-sys-color-surface-container-low);
    color: var(--md-sys-color-on-surface);
    transition:
      border-radius var(--md-sys-motion-duration-default) var(--md-sys-motion-easing-spatial),
      box-shadow var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
  }

  .folding-box[open] {
    border-radius: var(--md-sys-shape-corner-extra-large);
    box-shadow: var(--md-sys-elevation-level1);
  }

  summary {
    position: relative;
    display: grid;
    min-height: 64px;
    grid-template-columns: 40px minmax(0, 1fr) 24px;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    overflow: hidden;
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
    list-style: none;
  }

  summary::before {
    position: absolute;
    inset: 0;
    background: var(--folding-accent);
    content: "";
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: var(--md-sys-focus-ring-width) solid var(--md-sys-focus-ring-color);
    outline-offset: calc(-1 * var(--md-sys-focus-ring-width));
  }

  .summary-icon,
  .title,
  .arrow {
    position: relative;
    z-index: 1;
  }

  .summary-icon {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: var(--md-sys-shape-corner-medium);
    background: color-mix(in srgb, var(--folding-accent) 18%, transparent);
    color: var(--folding-accent);
  }

  .title {
    font-weight: 650;
  }

  .arrow {
    color: var(--md-sys-color-on-surface-variant);
    transition: rotate var(--md-sys-motion-duration-default) var(--md-sys-motion-easing-spatial);
  }

  details[open] .arrow {
    rotate: 180deg;
  }

  .content {
    padding: 4px 20px 20px 68px;
    border-top: 1px solid var(--md-sys-color-outline-variant);
    color: var(--md-sys-color-on-surface-variant);
    overflow-wrap: anywhere;
  }

  .content :global(> :first-child) { margin-top: 16px; }
  .content :global(> :last-child) { margin-bottom: 0; }

  .tone-error { --folding-accent: var(--md-sys-color-error); --folding-on-accent: var(--md-sys-color-on-error); }
  .tone-success { --folding-accent: var(--md-extended-color-success); --folding-on-accent: var(--md-extended-color-on-success); }
  .tone-info { --folding-accent: var(--md-extended-color-info); --folding-on-accent: var(--md-extended-color-on-info); }
  .tone-warning { --folding-accent: var(--md-extended-color-warning); --folding-on-accent: var(--md-extended-color-on-warning); }

  @media (hover: hover) {
    summary:hover::before { opacity: var(--md-sys-state-hover-opacity); }
  }

  @media (max-width: 479px) {
    .folding-box,
    .folding-box[open] {
      border-radius: var(--md-sys-shape-corner-large);
    }

    .content {
      padding: 4px 16px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .folding-box,
    summary::before,
    .arrow { transition: none; }
  }
</style>
