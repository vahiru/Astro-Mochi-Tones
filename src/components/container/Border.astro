---
interface Props {
  title?: string;
  color?: "default" | "red" | "orange" | "yellow" | "green" | "cyan" | "blue" | "purple";
}

const { title, color = "default" } = Astro.props;
const toneMap: Record<string, string> = {
  default: "surface",
  red: "error",
  orange: "warning",
  yellow: "warning",
  green: "success",
  cyan: "info",
  blue: "info",
  purple: "primary",
};
const tone = toneMap[color] ?? "surface";
---

<section class={`outlined-card tone-${tone}`} aria-label={title}>
  {
    title && (
      <div class="card-heading label-large">
        <span class="heading-indicator" aria-hidden="true"></span>
        {title}
      </div>
    )
  }
  <div class="card-content"><slot /></div>
</section>

<style>
  .outlined-card {
    --card-container: var(--md-sys-color-surface-container-low);
    --card-on-container: var(--md-sys-color-on-surface);
    --card-accent: var(--md-sys-color-outline);
    margin: 28px 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--card-accent) 72%, transparent);
    border-radius: var(--md-sys-shape-corner-large-increased);
    background: var(--card-container);
    color: var(--card-on-container);
  }

  .card-heading {
    display: flex;
    min-height: 48px;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    border-bottom: 1px solid color-mix(in srgb, var(--card-accent) 26%, transparent);
    color: var(--card-on-container);
    font-weight: 700;
  }

  .heading-indicator {
    width: 4px;
    height: 22px;
    flex: 0 0 4px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--card-accent);
  }

  .card-content {
    min-width: 0;
    padding: 20px;
    overflow-wrap: anywhere;
  }

  .card-content :global(> :first-child) {
    margin-top: 0;
  }

  .card-content :global(> :last-child) {
    margin-bottom: 0;
  }

  .tone-primary {
    --card-container: var(--md-sys-color-primary-container);
    --card-on-container: var(--md-sys-color-on-primary-container);
    --card-accent: var(--md-sys-color-primary);
  }

  .tone-info {
    --card-container: var(--md-extended-color-info-container);
    --card-on-container: var(--md-extended-color-on-info-container);
    --card-accent: var(--md-extended-color-info);
  }

  .tone-success {
    --card-container: var(--md-extended-color-success-container);
    --card-on-container: var(--md-extended-color-on-success-container);
    --card-accent: var(--md-extended-color-success);
  }

  .tone-warning {
    --card-container: var(--md-extended-color-warning-container);
    --card-on-container: var(--md-extended-color-on-warning-container);
    --card-accent: var(--md-extended-color-warning);
  }

  .tone-error {
    --card-container: var(--md-sys-color-error-container);
    --card-on-container: var(--md-sys-color-on-error-container);
    --card-accent: var(--md-sys-color-error);
  }

  @media (max-width: 479px) {
    .outlined-card {
      border-radius: var(--md-sys-shape-corner-large);
    }

    .card-heading,
    .card-content {
      padding-inline: 16px;
    }
  }
</style>
