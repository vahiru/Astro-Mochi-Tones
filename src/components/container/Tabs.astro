---
interface Props {
    active?: number;
    align?: "left" | "center";
    label?: string;
}

const { active = 0, align = "left", label = "内容标签页" } = Astro.props;
---

<div class="tabs-container" data-active={active}>
    <div
        class={`tabs-nav ${align}`}
        role="tablist"
        aria-label={label}
        aria-orientation="horizontal"
    ></div>
    <div class="tabs-content">
        <slot />
    </div>
</div>

<script>
    const setupTabs = (container: HTMLElement, instanceIndex: number) => {
        const nav = container.querySelector<HTMLElement>(".tabs-nav");
        const content = container.querySelector<HTMLElement>(".tabs-content");
        if (!nav || !content || container.dataset.tabsReady === "true") return;

        const items = Array.from(content.children).filter(
            (item): item is HTMLElement => item instanceof HTMLElement,
        );
        if (items.length === 0) return;

        container.dataset.tabsReady = "true";
        nav.replaceChildren();

        const requestedIndex = Number.parseInt(container.dataset.active ?? "0", 10);
        const initialIndex = Number.isFinite(requestedIndex)
            ? Math.min(Math.max(requestedIndex, 0), items.length - 1)
            : 0;
        const buttons: HTMLButtonElement[] = [];

        const activate = (activeIndex: number, moveFocus = false) => {
            items.forEach((item, index) => {
                const isActive = index === activeIndex;
                item.classList.toggle("active", isActive);
                item.hidden = !isActive;
                buttons[index]?.classList.toggle("active", isActive);
                buttons[index]?.setAttribute("aria-selected", String(isActive));
                if (buttons[index]) buttons[index].tabIndex = isActive ? 0 : -1;
            });

            if (moveFocus) {
                const activeButton = buttons[activeIndex];
                activeButton?.focus();
                activeButton?.scrollIntoView({
                    behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
                        ? "auto"
                        : "smooth",
                    block: "nearest",
                    inline: "nearest",
                });
            }
        };

        items.forEach((item, index) => {
            const title = item.dataset.title || `Tab ${index + 1}`;
            const tabId = `tabs-${instanceIndex}-tab-${index}`;
            const panelId = `tabs-${instanceIndex}-panel-${index}`;
            const button = document.createElement("button");
            const buttonLabel = document.createElement("span");

            button.type = "button";
            button.id = tabId;
            button.className = "tab-btn";
            button.setAttribute("role", "tab");
            button.setAttribute("aria-controls", panelId);
            button.setAttribute("aria-selected", "false");
            button.tabIndex = -1;

            buttonLabel.className = "tab-label";
            buttonLabel.textContent = title;
            button.append(buttonLabel);

            button.addEventListener("click", () => activate(index));
            button.addEventListener("keydown", (event) => {
                if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
                event.preventDefault();
                const direction = getComputedStyle(nav).direction === "rtl" ? -1 : 1;
                const nextIndex = event.key === "Home"
                    ? 0
                    : event.key === "End"
                      ? buttons.length - 1
                      : (
                            index
                            + (event.key === "ArrowRight" ? direction : -direction)
                            + buttons.length
                        ) % buttons.length;
                activate(nextIndex, true);
            });

            item.id = panelId;
            item.setAttribute("role", "tabpanel");
            item.setAttribute("aria-labelledby", tabId);
            item.tabIndex = 0;
            nav.appendChild(button);
            buttons.push(button);
        });

        activate(initialIndex);
    };

    const bindTabs = () => {
        document.querySelectorAll<HTMLElement>(".tabs-container").forEach(setupTabs);
    };

    bindTabs();
    document.addEventListener("astro:after-swap", bindTabs);
</script>

<style>
    .tabs-container {
        margin: 24px 0;
        overflow: hidden;
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-extra-large);
        background: var(--md-sys-color-surface-container-low);
    }

    .tabs-nav {
        display: flex;
        min-height: var(--md-sys-touch-target-size);
        align-items: stretch;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
        background: var(--md-sys-color-surface-container);
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scrollbar-color: var(--md-sys-color-outline-variant) transparent;
        scrollbar-width: thin;
    }

    .tabs-nav.center {
        justify-content: safe center;
    }

    :global(.tab-btn) {
        position: relative;
        isolation: isolate;
        display: inline-grid;
        min-width: 90px;
        min-height: var(--md-sys-touch-target-size);
        flex: 0 0 auto;
        padding: 0 24px;
        place-items: center;
        overflow: hidden;
        border: 0;
        background: transparent;
        color: var(--md-sys-color-on-surface-variant);
        cursor: pointer;
        font: inherit;
        font-size: var(--md-sys-typescale-title-small-size);
        font-weight: 600;
        letter-spacing: var(--md-sys-typescale-title-small-tracking);
        line-height: var(--md-sys-typescale-title-small-line-height);
        transition:
            color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
    }

    :global(.tab-btn::before) {
        position: absolute;
        z-index: -1;
        inset: 0;
        background: currentColor;
        content: "";
        opacity: 0;
        transition: opacity var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
    }

    :global(.tab-btn::after) {
        position: absolute;
        inset-block-end: 0;
        inset-inline-start: 50%;
        width: 32px;
        height: 3px;
        border-radius:
            var(--md-sys-shape-corner-extra-small)
            var(--md-sys-shape-corner-extra-small)
            0
            0;
        background: var(--md-sys-color-primary);
        content: "";
        opacity: 0;
        scale: 0.5 1;
        translate: -50% 0;
        transition:
            opacity var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
            scale var(--md-sys-motion-duration-default) var(--md-sys-motion-easing-spatial);
    }

    :global(.tab-label) {
        position: relative;
        z-index: 1;
        white-space: nowrap;
    }

    :global(.tab-btn.active) {
        color: var(--md-sys-color-primary);
    }

    :global(.tab-btn.active::after) {
        opacity: 1;
        scale: 1 1;
    }

    :global(.tab-btn:focus-visible) {
        outline: var(--md-sys-focus-ring-width) solid var(--md-sys-focus-ring-color);
        outline-offset: calc(-1 * var(--md-sys-focus-ring-width));
    }

    :global(.tab-btn:active::before) {
        opacity: var(--md-sys-state-pressed-opacity);
    }

    .tabs-content {
        padding: 24px;
        background: var(--md-sys-color-surface);
        color: var(--md-sys-color-on-surface);
        overflow-wrap: anywhere;
    }

    .tabs-container:not([data-tabs-ready="true"]) .tabs-content > :global(.tab-item:first-child) {
        display: block;
    }

    @media (hover: hover) {
        :global(.tab-btn:hover::before) {
            opacity: var(--md-sys-state-hover-opacity);
        }
    }

    @media (max-width: 479px) {
        .tabs-container {
            border-radius: var(--md-sys-shape-corner-large);
        }

        :global(.tab-btn) {
            min-width: 80px;
            padding-inline: 16px;
        }

        .tabs-content {
            padding: 16px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.tab-btn),
        :global(.tab-btn::before),
        :global(.tab-btn::after) {
            transition: none;
        }
    }
</style>
