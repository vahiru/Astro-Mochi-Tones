---
import type { Page } from "astro";
import "@material/web/icon/icon.js";
import themeConfig from "astro-mochi-tones:config";

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
const previousUrl = page.url.prev;
const nextUrl = page.url.next;
const pageInfo = themeConfig.labels.pageInfoTemplate
  .replaceAll("{current}", String(page.currentPage))
  .replaceAll("{total}", String(page.lastPage));
---

<nav class="pagination-nav" aria-label={themeConfig.labels.paginationLabel}>
  {
    previousUrl ? (
      <a class="nav-button" href={previousUrl} rel="prev">
        <md-icon aria-hidden="true">arrow_back</md-icon>
        <span>{themeConfig.labels.paginationPrevious}</span>
      </a>
    ) : (
      <span class="nav-button is-disabled" aria-disabled="true">
        <md-icon aria-hidden="true">arrow_back</md-icon>
        <span>{themeConfig.labels.paginationPrevious}</span>
      </span>
    )
  }

  <span class="page-info label-large" aria-current="page">{pageInfo}</span>

  {
    nextUrl ? (
      <a class="nav-button" href={nextUrl} rel="next">
        <span>{themeConfig.labels.paginationNext}</span>
        <md-icon aria-hidden="true">arrow_forward</md-icon>
      </a>
    ) : (
      <span class="nav-button is-disabled" aria-disabled="true">
        <span>{themeConfig.labels.paginationNext}</span>
        <md-icon aria-hidden="true">arrow_forward</md-icon>
      </span>
    )
  }
</nav>

<style>
  .pagination-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    margin-top: clamp(40px, 7vw, 64px);
    padding-top: 24px;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .nav-button {
    position: relative;
    display: inline-flex;
    min-width: 0;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    overflow: hidden;
    padding: 0 18px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: 650;
    line-height: var(--md-sys-typescale-label-large-line-height);
    transition:
      background-color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      box-shadow var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      translate var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-spatial);
  }

  .nav-button:first-child {
    justify-self: start;
  }

  .nav-button:last-child {
    justify-self: end;
  }

  a.nav-button::before {
    position: absolute;
    inset: 0;
    background: currentColor;
    content: "";
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
  }

  a.nav-button:hover::before {
    opacity: var(--md-sys-state-hover-opacity);
  }

  a.nav-button:active::before {
    opacity: var(--md-sys-state-pressed-opacity);
  }

  a.nav-button:focus-visible {
    outline: 3px solid var(--md-sys-color-primary);
    outline-offset: 3px;
  }

  .nav-button md-icon {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    font-size: 20px;
  }

  .nav-button span,
  .nav-button md-icon {
    position: relative;
    z-index: 1;
  }

  .nav-button.is-disabled {
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    cursor: not-allowed;
    opacity: 0.38;
  }

  .page-info {
    min-width: max-content;
    padding: 8px 12px;
    border-radius: var(--md-sys-shape-corner-small);
    color: var(--md-sys-color-on-surface-variant);
    text-align: center;
  }

  @media (hover: hover) {
    a.nav-button:hover {
      box-shadow: var(--md-sys-elevation-level1);
      translate: 0 -2px;
    }
  }

  @media (max-width: 479px) {
    .pagination-nav {
      gap: 6px;
    }

    .nav-button {
      width: 48px;
      padding-inline: 0;
    }

    .nav-button span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .page-info {
      padding-inline: 6px;
    }
  }
</style>
