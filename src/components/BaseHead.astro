---
import { getImage } from "astro:assets";
import themeConfig from "astro-mochi-tones:config";
import { sanitizeAssetUrl } from "../utils/security";
import { isLocalAsset, resolveImage } from "../utils/images";
// 图标字体自托管并由 Vite 输出带哈希的地址，预加载可以让首屏图标尽早可见。
import iconFontUrl from "../assets/fonts/material-symbols-rounded-subset.woff2?url";

interface Props {
  title: string;
  description: string;
  image?: string;
  articleDate?: Date;
}

const {
  title,
  description,
  image = themeConfig.defaultImage,
  articleDate,
} = Astro.props;

const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);

/*
 * 社交预览图。命中 src/assets/images/ 时交给 astro:assets 输出 1200px 宽的 JPEG：
 * 各家抓取器对 WebP 的支持不一致，而 1200px 是 Open Graph 的推荐宽度，
 * 所以这里固定格式和宽度，不做多尺寸。其余情况（public/ 下的文件、/og/*.png
 * 这类构建期生成的端点、外链）按原地址输出。
 */
const OG_WIDTH = 1200;

const resolveSocialImage = async (value: string) => {
  const normalized = value.startsWith("/") || /^https:\/\//i.test(value)
    ? value
    : `/images/${value}`;
  const asset = await resolveImage(normalized);

  if (isLocalAsset(asset)) {
    const optimized = await getImage({
      src: asset,
      width: Math.min(asset.width, OG_WIDTH),
      format: "jpeg",
    });
    return {
      url: new URL(optimized.src, siteBase),
      width: optimized.attributes.width ?? optimized.options.width,
      height: optimized.attributes.height ?? optimized.options.height,
    };
  }

  const safeValue = sanitizeAssetUrl(typeof asset === "string" ? asset : normalized)
    ?? sanitizeAssetUrl(themeConfig.defaultImage)
    ?? "/images/default-og.png";
  return { url: new URL(safeValue, siteBase), width: undefined, height: undefined };
};

const socialImage = await resolveSocialImage(image);
const socialImageURL = socialImage.url;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fffbfe" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141218" />

<link
  rel="preload"
  href={iconFontUrl}
  as="font"
  type="font/woff2"
  crossorigin
/>

<link rel="icon" href={themeConfig.favicon} />
<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={articleDate ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={themeConfig.title} />
<meta property="og:locale" content={themeConfig.locale} />
<meta property="og:image" content={socialImageURL} />
{socialImage.width && <meta property="og:image:width" content={String(socialImage.width)} />}
{socialImage.height && <meta property="og:image:height" content={String(socialImage.height)} />}
{articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

{
  themeConfig.fonts.map((font) => (
    <link
      rel={font.rel}
      href={font.href}
      crossorigin={font.crossorigin ? true : undefined}
    />
  ))
}
