---
interface Props {
    date?: string;
    datetime?: string;
}

const { date, datetime } = Astro.props;
const inferredDatetime = datetime ?? (
    date && /^\d{4}-\d{2}-\d{2}(?:[T ][\d:.+-Z]+)?$/i.test(date) ? date : undefined
);
---

<div class:list={["timeline-node", { "has-date": Boolean(date) }]} role="listitem">
    <span class="node-point" aria-hidden="true"></span>
    {date && (
        <div class="node-date">
            {inferredDatetime ? <time datetime={inferredDatetime}>{date}</time> : date}
        </div>
    )}
    <div class="node-content">
        <slot />
    </div>
</div>

<style>
    .timeline-node {
        position: relative;
        margin-block-end: 24px;
    }

    .timeline-node:last-child {
        margin-block-end: 0;
    }

    .node-point {
        position: absolute;
        inset-block-start: 19px;
        inset-inline-start: -37px;
        width: 10px;
        height: 10px;
        box-sizing: content-box;
        border: 4px solid var(--md-sys-color-surface);
        border-radius: var(--md-sys-shape-corner-full);
        background: var(--md-sys-color-primary);
        outline: 1px solid var(--md-sys-color-primary);
    }

    .timeline-node.has-date .node-point {
        inset-block-start: 5px;
    }

    .node-date {
        display: inline-flex;
        min-height: 28px;
        align-items: center;
        margin-block-end: 8px;
        padding: 4px 10px;
        border-radius: var(--md-sys-shape-corner-small);
        background: var(--md-sys-color-primary-container);
        color: var(--md-sys-color-on-primary-container);
        font-size: var(--md-sys-typescale-label-medium-size);
        font-weight: 650;
        letter-spacing: var(--md-sys-typescale-label-medium-tracking);
        line-height: var(--md-sys-typescale-label-medium-line-height);
    }

    .node-content {
        padding: 16px 20px;
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-large);
        background: var(--md-sys-color-surface-container-low);
        color: var(--md-sys-color-on-surface);
        font-size: var(--md-sys-typescale-body-large-size);
        letter-spacing: var(--md-sys-typescale-body-large-tracking);
        line-height: var(--md-sys-typescale-body-large-line-height);
        overflow-wrap: anywhere;
    }

    .node-content :global(> :first-child) {
        margin-top: 0;
    }

    .node-content :global(> :last-child) {
        margin-bottom: 0;
    }

    @media (max-width: 479px) {
        .node-point {
            inset-inline-start: -34px;
        }

        .node-content {
            padding: 16px;
            border-radius: var(--md-sys-shape-corner-medium);
        }
    }
</style>
