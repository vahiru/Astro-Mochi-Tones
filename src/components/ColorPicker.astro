---
import themeConfig from "astro-mochi-tones:config";

const { labels, colorPicker } = themeConfig;
---

<dialog id="theme-dialog" class="theme-dialog" aria-labelledby="theme-dialog-title">
  <div class="dialog-content">
    <div class="dialog-heading">
      <span class="dialog-icon" aria-hidden="true"><md-icon>palette</md-icon></span>
      <div>
        <h2 id="theme-dialog-title" class="dialog-title">{labels.customizeTheme}</h2>
        <p class="dialog-supporting">基于所选种子色生成成对、可访问的 Material 3 色彩角色。</p>
      </div>
    </div>

    <section class="color-section" aria-labelledby="preset-colors-title">
      <h3 id="preset-colors-title" class="section-label">{labels.presetColors}</h3>
      <div class="preset-colors">
        {
          colorPicker.presetColors.map((color) => (
            <button
              class="color-button"
              type="button"
              style={`--swatch-color: ${color}`}
              data-color={color}
              aria-label={`使用主题色 ${color}`}
              title={color}
            >
              <span class="swatch"></span>
              <md-icon class="selected-icon">check</md-icon>
            </button>
          ))
        }
      </div>
    </section>

    <section class="color-section" aria-labelledby="custom-color-title">
      <h3 id="custom-color-title" class="section-label">{labels.customColor}</h3>
      <label class="custom-picker" for="color-input">
        <input
          type="color"
          id="color-input"
          value={colorPicker.defaultColor}
          data-default-color={colorPicker.defaultColor}
        />
        <span>
          <span class="picker-label">{labels.pickColor}</span>
          <span id="color-value" class="picker-value">{colorPicker.defaultColor}</span>
        </span>
      </label>
    </section>

    <div class="dialog-actions">
      <button id="close-theme-dialog" class="text-button" type="button">{labels.close}</button>
    </div>
  </div>
</dialog>

<script>
  import {
    argbFromHex,
    hexFromArgb,
    themeFromSourceColor,
  } from "@material/material-color-utilities";

  const dialog = document.querySelector<HTMLDialogElement>("#theme-dialog");
  const colorInput = document.querySelector<HTMLInputElement>("#color-input");
  const colorValue = document.querySelector<HTMLElement>("#color-value");
  const colorButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".color-button"));
  let activeSourceColor: string | null = null;

  const isHexColor = (value: string): value is `#${string}` => /^#[0-9a-f]{6}$/i.test(value);

  const getSavedColor = () => {
    try {
      const value = localStorage.getItem("source-color");
      return value && isHexColor(value) ? value : null;
    } catch {
      return null;
    }
  };

  const saveColor = (value: string) => {
    try {
      localStorage.setItem("source-color", value);
    } catch {
      // The selected color remains active for the current page.
    }
  };

  const updateSelection = (hexColor: string) => {
    const normalized = hexColor.toLowerCase();
    colorButtons.forEach((button) => {
      const selected = button.dataset.color?.toLowerCase() === normalized;
      button.setAttribute("aria-pressed", String(selected));
    });
    if (colorInput) colorInput.value = hexColor;
    if (colorValue) colorValue.textContent = hexColor.toUpperCase();
  };

  const applyTheme = (hexColor: string, persist = true) => {
    if (!isHexColor(hexColor)) return;

    const dark = document.documentElement.classList.contains("dark");
    const theme = themeFromSourceColor(argbFromHex(hexColor));
    const scheme = dark ? theme.schemes.dark : theme.schemes.light;
    const values = scheme.toJSON();
    const root = document.documentElement;

    const roleMap = {
      primary: "primary",
      onPrimary: "on-primary",
      primaryContainer: "primary-container",
      onPrimaryContainer: "on-primary-container",
      secondary: "secondary",
      onSecondary: "on-secondary",
      secondaryContainer: "secondary-container",
      onSecondaryContainer: "on-secondary-container",
      tertiary: "tertiary",
      onTertiary: "on-tertiary",
      tertiaryContainer: "tertiary-container",
      onTertiaryContainer: "on-tertiary-container",
      error: "error",
      onError: "on-error",
      errorContainer: "error-container",
      onErrorContainer: "on-error-container",
      surface: "surface",
      onSurface: "on-surface",
      surfaceVariant: "surface-variant",
      onSurfaceVariant: "on-surface-variant",
      outline: "outline",
      outlineVariant: "outline-variant",
      shadow: "shadow",
      scrim: "scrim",
      inverseSurface: "inverse-surface",
      inverseOnSurface: "inverse-on-surface",
      inversePrimary: "inverse-primary",
    } as const;

    (Object.entries(roleMap) as Array<[keyof typeof values, string]>).forEach(([key, token]) => {
      root.style.setProperty(`--md-sys-color-${token}`, hexFromArgb(values[key]));
    });

    const neutral = theme.palettes.neutral;
    const surfaceTones = dark
      ? {
          "surface-dim": 6,
          "surface-bright": 24,
          "surface-container-lowest": 4,
          "surface-container-low": 10,
          "surface-container": 12,
          "surface-container-high": 17,
          "surface-container-highest": 22,
        }
      : {
          "surface-dim": 87,
          "surface-bright": 98,
          "surface-container-lowest": 100,
          "surface-container-low": 96,
          "surface-container": 94,
          "surface-container-high": 92,
          "surface-container-highest": 90,
        };

    Object.entries(surfaceTones).forEach(([token, tone]) => {
      root.style.setProperty(`--md-sys-color-${token}`, hexFromArgb(neutral.tone(tone)));
    });
    root.style.setProperty("--md-sys-color-background", hexFromArgb(values.surface));
    root.style.setProperty("--md-sys-color-on-background", hexFromArgb(values.onSurface));

    activeSourceColor = hexColor.toLowerCase();
    if (persist) saveColor(activeSourceColor);
    updateSelection(activeSourceColor);
  };

  window.addEventListener("open-theme-picker", () => {
    if (!dialog?.open) dialog?.showModal();
    colorInput?.focus();
  });

  document.querySelector<HTMLButtonElement>("#close-theme-dialog")?.addEventListener("click", () => {
    dialog?.close();
  });

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  colorButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const color = button.dataset.color;
      if (color) applyTheme(color);
    });
  });

  colorInput?.addEventListener("input", () => applyTheme(colorInput.value));

  window.addEventListener("theme-change", () => {
    if (activeSourceColor) applyTheme(activeSourceColor, false);
  });

  const savedColor = getSavedColor();
  if (savedColor) {
    applyTheme(savedColor, false);
  } else {
    updateSelection(colorInput?.dataset.defaultColor ?? "#6750a4");
  }
</script>

<style>
  .theme-dialog {
    width: min(92vw, 520px);
    max-height: min(84dvh, 680px);
    margin: auto;
    padding: 0;
    overflow: hidden auto;
    border: 0;
    border-radius: var(--md-sys-shape-corner-extra-large);
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
    box-shadow: var(--md-sys-elevation-level3);
  }

  .theme-dialog::backdrop {
    background: color-mix(in srgb, var(--md-sys-color-scrim) 56%, transparent);
    backdrop-filter: blur(3px);
  }

  .dialog-content {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 28px;
  }

  .dialog-heading {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .dialog-icon {
    display: grid;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    place-items: center;
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .dialog-title {
    margin: 0;
    font-size: var(--md-sys-typescale-headline-small-size);
    font-weight: 500;
    line-height: var(--md-sys-typescale-headline-small-line-height);
  }

  .dialog-supporting {
    margin: 6px 0 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: var(--md-sys-typescale-body-medium-line-height);
  }

  .color-section {
    display: grid;
    gap: 12px;
  }

  .section-label {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-title-small-size);
    font-weight: 600;
    line-height: var(--md-sys-typescale-title-small-line-height);
  }

  .preset-colors {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .color-button {
    position: relative;
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-surface-container-lowest);
    cursor: pointer;
    transition:
      border-radius var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-spatial),
      scale var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-spatial);
  }

  .swatch {
    width: 36px;
    height: 36px;
    border-radius: var(--md-sys-shape-corner-medium);
    background: var(--swatch-color);
  }

  .selected-icon {
    position: absolute;
    display: none;
    width: 24px;
    height: 24px;
    place-items: center;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-inverse-surface);
    color: var(--md-sys-color-inverse-on-surface);
    font-size: 20px;
  }

  .color-button[aria-pressed="true"] {
    border: 3px solid var(--md-sys-color-primary);
  }

  .color-button[aria-pressed="true"] .selected-icon {
    display: inline-grid;
  }

  .custom-picker {
    display: flex;
    min-height: 72px;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-surface-container-low);
    cursor: pointer;
  }

  input[type="color"] {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    padding: 3px;
    border: 0;
    border-radius: var(--md-sys-shape-corner-medium);
    background: transparent;
    cursor: pointer;
  }

  .picker-label,
  .picker-value {
    display: block;
  }

  .picker-label {
    font-size: var(--md-sys-typescale-body-large-size);
    font-weight: 500;
  }

  .picker-value {
    margin-top: 2px;
    color: var(--md-sys-color-on-surface-variant);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: var(--md-sys-typescale-body-small-size);
  }

  .dialog-actions {
    display: flex;
    justify-content: flex-end;
  }

  .text-button {
    min-height: var(--md-sys-touch-target-size);
    padding: 0 20px;
    border: 0;
    border-radius: var(--md-sys-shape-corner-full);
    background: transparent;
    color: var(--md-sys-color-primary);
    font-family: inherit;
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
  }

  .text-button:active {
    background: color-mix(
      in srgb,
      var(--md-sys-color-primary) calc(var(--md-sys-state-pressed-opacity) * 100%),
      transparent
    );
  }

  @media (hover: hover) {
    .color-button:hover {
      border-radius: var(--md-sys-shape-corner-extra-large);
      scale: 1.05;
    }

    .text-button:hover {
      background: color-mix(
        in srgb,
        var(--md-sys-color-primary) calc(var(--md-sys-state-hover-opacity) * 100%),
        transparent
      );
    }
  }

  @media (max-width: 599px) {
    .theme-dialog {
      width: calc(100vw - 24px);
      max-height: calc(100dvh - 24px);
      border-radius: var(--md-sys-shape-corner-extra-large);
    }

    .dialog-content {
      padding: 24px;
    }
  }
</style>
