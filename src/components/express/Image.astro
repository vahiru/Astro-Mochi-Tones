---
import { Image, getImage } from "astro:assets";
import {
  sanitizeAssetUrl,
  sanitizeCssColor,
  sanitizeCssLength,
  sanitizeCssSpacing,
} from "../../utils/security";
import { isLocalAsset, resolveImage } from "../../utils/images";

interface Props {
  src: string;
  desc?: string;
  download?: boolean | string;
  width?: string;
  height?: string;
  padding?: string;
  bg?: string;
  fancybox?: boolean;
}

const { src, desc, download, width, height, padding, bg, fancybox = true } = Astro.props;
const safeSrc = sanitizeAssetUrl(src);
const safeWidth = sanitizeCssLength(width);
const safeHeight = sanitizeCssLength(height);
const safePadding = sanitizeCssSpacing(padding);
const safeBackground = sanitizeCssColor(bg);


/*
 * 正文栏宽上限是 820px，按 2x 高清屏最多需要 1640px。命中 src/assets/images/
 * 的图片交给 astro:assets 生成多尺寸 WebP；点开大图的链接指向最大那一档，
 * 而不是未优化的原图。
 */
const asset = await resolveImage(src);
const localAsset = isLocalAsset(asset) ? asset : null;
const contentWidths = [420, 820, 1240, 1640];
const contentSizes = "(min-width: 1100px) 820px, (min-width: 700px) 78vw, 92vw";
const lightboxHref = localAsset
  ? (await getImage({
      src: localAsset,
      width: Math.min(localAsset.width, 1640),
      format: "webp",
    })).src
  : safeSrc;

// 下载按钮必须指向真实存在的地址：src/assets/ 下的原文件不会被直接发布，
// 所以本地资源要用优化后的产物地址。
let downloadUrl: string | undefined;
if (download === true || download === "true") {
  downloadUrl = lightboxHref ?? undefined;
} else if (typeof download === "string" && download) {
  const target = await resolveImage(download);
  downloadUrl = isLocalAsset(target)
    ? (await getImage({ src: target, format: "webp" })).src
    : (target ?? undefined);
}

const containerStyle = [
  safeBackground && `background-color: ${safeBackground}`,
  safePadding && `padding: ${safePadding}`,
  safeWidth && `width: ${safeWidth}`,
]
  .filter(Boolean)
  .join("; ");
const imageStyle = [safeHeight && `height: ${safeHeight}`, safeHeight && "object-fit: contain"].filter(Boolean).join("; ");
---

{
  safeSrc && (
    <div class="express-image-wrapper">
      <figure class="express-figure" style={containerStyle}>
        <a
          class="image-link"
          href={lightboxHref}
          data-fancybox={fancybox ? "gallery" : undefined}
          data-caption={desc}
          aria-label={desc ? `查看大图：${desc}` : "查看大图"}
        >
          {localAsset ? (
            <Image
              src={localAsset}
              alt={desc || ""}
              style={imageStyle}
              widths={contentWidths.filter((width) => width <= localAsset.width)}
              sizes={contentSizes}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <img
              src={safeSrc}
              alt={desc || ""}
              style={imageStyle}
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          )}
        </a>
        {(desc || downloadUrl) && (
          <div class="image-meta">
            {desc ? <figcaption class="body-small">{desc}</figcaption> : <span aria-hidden="true" />}
            {downloadUrl && (
              <a
                href={downloadUrl}
                class="download-btn"
                download
                aria-label={desc ? `下载图片：${desc}` : "下载图片"}
                title="下载图片"
              >
                <md-icon aria-hidden="true">download</md-icon>
                <md-ripple></md-ripple>
              </a>
            )}
          </div>
        )}
      </figure>
    </div>
  )
}

<script>
  import "@material/web/icon/icon.js";
  import "@material/web/ripple/ripple.js";
</script>

<style>
  .express-image-wrapper {
    display: flex;
    min-width: 0;
    justify-content: center;
    margin: 28px 0;
  }

  .express-figure {
    display: inline-flex;
    max-width: 100%;
    flex-direction: column;
    align-items: stretch;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    background: var(--md-sys-color-surface-container-low);
    box-shadow: var(--md-sys-elevation-level1);
  }

  .image-link {
    display: block;
    min-width: 0;
    overflow: hidden;
    background: var(--md-sys-color-surface-container-highest);
  }

  .image-link:focus-visible {
    position: relative;
    z-index: 1;
    outline: var(--md-sys-focus-ring-width) solid var(--md-sys-focus-ring-color);
    outline-offset: calc(-1 * var(--md-sys-focus-ring-width));
  }

  .image-link img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    transition: scale var(--md-sys-motion-duration-slow) var(--md-sys-motion-easing-spatial);
  }

  .image-meta {
    display: grid;
    min-height: 56px;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border-top: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface-container);
  }

  figcaption {
    min-width: 0;
    color: var(--md-sys-color-on-surface-variant);
    text-align: start;
  }

  .download-btn {
    position: relative;
    display: grid;
    width: var(--md-sys-touch-target-size);
    height: var(--md-sys-touch-target-size);
    place-items: center;
    overflow: hidden;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .download-btn:focus-visible {
    outline: var(--md-sys-focus-ring-width) solid var(--md-sys-focus-ring-color);
    outline-offset: var(--md-sys-focus-ring-offset);
  }

  .download-btn md-icon { width: 20px; height: 20px; font-size: 20px; }
  .download-btn md-ripple { border-radius: inherit; }

  @media (hover: hover) {
    .image-link:hover img { scale: 1.02; }
  }

  @media (max-width: 599px) {
    .express-figure { border-radius: var(--md-sys-shape-corner-large); }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-link img { transition: none; }
  }
</style>
