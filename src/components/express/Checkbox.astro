---
import "@material/web/icon/icon.js";

interface Props {
  checked?: boolean;
  disabled?: boolean;
  color?: "default" | "primary" | "secondary" | "tertiary" | "error" | "success" | "info" | "warning";
  symbol?: "plus" | "minus" | "times" | "check";
  label?: string;
}

const {
  checked = false,
  disabled = false,
  color = "default",
  symbol = "check",
  label,
} = Astro.props;
const iconMap = { check: "check", plus: "add", minus: "remove", times: "close" } as const;
const finalIcon = iconMap[symbol] ?? "check";
---

<label class:list={["md3-checkbox", `tone-${color}`, { "is-disabled": disabled }]}>
  <input class="native-control" type="checkbox" checked={checked} disabled={disabled} aria-label={label} />
  <span class="selection-control" aria-hidden="true">
    <span class="selection-indicator"><md-icon>{finalIcon}</md-icon></span>
  </span>
  <span class="selection-label body-medium"><slot>{label}</slot></span>
</label>

<style>
  .md3-checkbox {
    --selection-color: var(--md-sys-color-primary);
    --selection-on-color: var(--md-sys-color-on-primary);
    position: relative;
    display: inline-flex;
    min-height: var(--md-sys-touch-target-size);
    align-items: center;
    gap: 8px;
    margin: 2px 0;
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
    vertical-align: middle;
  }

  .native-control {
    position: absolute;
    z-index: 2;
    left: 0;
    width: var(--md-sys-touch-target-size);
    height: var(--md-sys-touch-target-size);
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }

  .selection-control {
    position: relative;
    display: grid;
    width: var(--md-sys-touch-target-size);
    height: var(--md-sys-touch-target-size);
    flex: 0 0 var(--md-sys-touch-target-size);
    place-items: center;
    border-radius: var(--md-sys-shape-corner-full);
    overflow: hidden;
  }

  .selection-control::before {
    position: absolute;
    inset: 4px;
    border-radius: inherit;
    background: var(--selection-color);
    content: "";
    opacity: 0;
    transition: opacity var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
  }

  .selection-indicator {
    position: relative;
    z-index: 1;
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border: 2px solid var(--md-sys-color-on-surface-variant);
    border-radius: var(--md-sys-shape-corner-extra-small);
    background: transparent;
    color: transparent;
    transition:
      background-color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      border-color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      scale var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-spatial);
  }

  .selection-indicator md-icon {
    width: 16px;
    height: 16px;
    font-size: 16px;
    font-weight: 700;
  }

  .native-control:checked + .selection-control .selection-indicator {
    border-color: var(--selection-color);
    background: var(--selection-color);
    color: var(--selection-on-color);
  }

  .native-control:active + .selection-control .selection-indicator {
    scale: 0.9;
  }

  .native-control:focus-visible + .selection-control {
    outline: var(--md-sys-focus-ring-width) solid var(--md-sys-focus-ring-color);
    outline-offset: var(--md-sys-focus-ring-offset);
  }

  .selection-label {
    min-width: 0;
    padding-right: 4px;
    line-height: var(--md-sys-typescale-body-medium-line-height);
  }

  .tone-secondary {
    --selection-color: var(--md-sys-color-secondary);
    --selection-on-color: var(--md-sys-color-on-secondary);
  }

  .tone-tertiary {
    --selection-color: var(--md-sys-color-tertiary);
    --selection-on-color: var(--md-sys-color-on-tertiary);
  }

  .tone-error {
    --selection-color: var(--md-sys-color-error);
    --selection-on-color: var(--md-sys-color-on-error);
  }

  .tone-success {
    --selection-color: var(--md-extended-color-success);
    --selection-on-color: var(--md-extended-color-on-success);
  }

  .tone-info {
    --selection-color: var(--md-extended-color-info);
    --selection-on-color: var(--md-extended-color-on-info);
  }

  .tone-warning {
    --selection-color: var(--md-extended-color-warning);
    --selection-on-color: var(--md-extended-color-on-warning);
  }

  .is-disabled {
    cursor: not-allowed;
    opacity: var(--md-sys-state-disabled-opacity);
  }

  @media (hover: hover) {
    .md3-checkbox:not(.is-disabled):hover .selection-control::before {
      opacity: var(--md-sys-state-hover-opacity);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selection-control::before,
    .selection-indicator {
      transition: none;
    }
  }
</style>
