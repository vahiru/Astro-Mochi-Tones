---
import "@material/web/icon/icon.js";

interface Props {
  color?:
    | "default"
    | "primary"
    | "secondary"
    | "info"
    | "success"
    | "warning"
    | "error"
    | "red"
    | "orange"
    | "yellow"
    | "green"
    | "cyan"
    | "blue"
    | "purple";
  title?: string;
  icon?: string;
}

const { color = "default", title, icon } = Astro.props;
const toneMap: Record<string, string> = {
  default: "surface",
  primary: "primary",
  purple: "primary",
  secondary: "secondary",
  info: "info",
  cyan: "info",
  blue: "info",
  success: "success",
  green: "success",
  warning: "warning",
  orange: "warning",
  yellow: "warning",
  error: "error",
  red: "error",
};
const iconMap: Record<string, string> = {
  surface: "notes",
  primary: "lightbulb",
  secondary: "bookmark",
  info: "info",
  success: "check_circle",
  warning: "warning",
  error: "error",
};
const tone = toneMap[color] ?? "surface";
const finalIcon = icon ?? iconMap[tone];
---

<aside class={`md3-note tone-${tone}`} role="note" aria-label={title}>
  <span class="note-icon-surface" aria-hidden="true">
    <md-icon>{finalIcon}</md-icon>
  </span>
  <div class="note-body">
    {title && <div class="note-title title-small">{title}</div>}
    <div class="note-content body-medium"><slot /></div>
  </div>
</aside>

<style>
  .md3-note {
    --note-container: var(--md-sys-color-surface-container);
    --note-on-container: var(--md-sys-color-on-surface);
    --note-accent: var(--md-sys-color-primary-container);
    --note-on-accent: var(--md-sys-color-on-primary-container);
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: start;
    gap: 16px;
    margin: 24px 0;
    padding: 20px;
    border: 1px solid color-mix(in srgb, var(--note-on-container) 16%, transparent);
    border-radius: var(--md-sys-shape-corner-large-increased);
    background: var(--note-container);
    color: var(--note-on-container);
  }

  .note-icon-surface {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: var(--md-sys-shape-corner-medium);
    background: var(--note-accent);
    color: var(--note-on-accent);
  }

  .note-icon-surface md-icon {
    width: 22px;
    height: 22px;
    font-size: 22px;
    font-variation-settings: "FILL" 1, "wght" 500, "GRAD" 0, "opsz" 24;
  }

  .note-body {
    min-width: 0;
    padding-top: 1px;
  }

  .note-title {
    margin-bottom: 4px;
    color: var(--note-on-container);
    font-weight: 700;
  }

  .note-content {
    color: var(--note-on-container);
    overflow-wrap: anywhere;
    opacity: 0.88;
  }

  .note-content :global(p:first-child) {
    margin-top: 0;
  }

  .note-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .tone-primary {
    --note-container: var(--md-sys-color-primary-container);
    --note-on-container: var(--md-sys-color-on-primary-container);
    --note-accent: var(--md-sys-color-primary);
    --note-on-accent: var(--md-sys-color-on-primary);
  }

  .tone-secondary {
    --note-container: var(--md-sys-color-secondary-container);
    --note-on-container: var(--md-sys-color-on-secondary-container);
    --note-accent: var(--md-sys-color-secondary);
    --note-on-accent: var(--md-sys-color-on-secondary);
  }

  .tone-info {
    --note-container: var(--md-extended-color-info-container);
    --note-on-container: var(--md-extended-color-on-info-container);
    --note-accent: var(--md-extended-color-info);
    --note-on-accent: var(--md-extended-color-on-info);
  }

  .tone-success {
    --note-container: var(--md-extended-color-success-container);
    --note-on-container: var(--md-extended-color-on-success-container);
    --note-accent: var(--md-extended-color-success);
    --note-on-accent: var(--md-extended-color-on-success);
  }

  .tone-warning {
    --note-container: var(--md-extended-color-warning-container);
    --note-on-container: var(--md-extended-color-on-warning-container);
    --note-accent: var(--md-extended-color-warning);
    --note-on-accent: var(--md-extended-color-on-warning);
  }

  .tone-error {
    --note-container: var(--md-sys-color-error-container);
    --note-on-container: var(--md-sys-color-on-error-container);
    --note-accent: var(--md-sys-color-error);
    --note-on-accent: var(--md-sys-color-on-error);
  }

  @media (max-width: 479px) {
    .md3-note {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 12px;
      padding: 16px;
      border-radius: var(--md-sys-shape-corner-large);
    }

    .note-icon-surface {
      width: 36px;
      height: 36px;
    }
  }
</style>
