---
import "@material/web/icon/icon.js";

interface Props {
    href: string;
    title?: string;
    icon?: string;
    desc?: string;
}

const { href, title, icon, desc } = Astro.props;
const displayTitle = title || href;
---

<a href={href} class="md3-link-card" target="_blank" rel="noopener noreferrer">
    <div class="link-visual">
        {icon ? (
            <img src={icon} alt="" class="link-favicon" />
        ) : (
            <div class="link-placeholder">
                <md-icon>link</md-icon>
            </div>
        )}
    </div>
    
    <div class="link-info">
        <div class="link-title title-small">{displayTitle}</div>
        {desc && <div class="link-desc body-small">{desc}</div>}
        <div class="link-url label-small">{href}</div>
    </div>

    <md-icon class="link-arrow">open_in_new</md-icon>
    <md-ripple></md-ripple>
</a>

<script>
    import "@material/web/ripple/ripple.js";
</script>

<style>
    .md3-link-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px 16px;
        margin: 1.5rem 0;
        background-color: var(--md-sys-color-surface-container-low);
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: 16px;
        text-decoration: none !important;
        color: var(--md-sys-color-on-surface);
        position: relative;
        overflow: hidden;
        transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), background-color 0.2s, box-shadow 0.2s;
        box-shadow: var(--md-sys-elevation-level0);
    }

    .md3-link-card:hover {
        transform: translateY(-2px);
        background-color: var(--md-sys-color-surface-container-high);
        border-color: var(--md-sys-color-primary);
        box-shadow: var(--md-sys-elevation-level1);
    }

    .link-visual {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        overflow: hidden;
        background-color: var(--md-sys-color-surface-variant);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .link-favicon {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .link-placeholder {
        color: var(--md-sys-color-on-surface-variant);
        opacity: 0.6;
    }

    .link-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .link-title {
        color: var(--md-sys-color-on-surface);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 600;
    }

    .link-desc {
        color: var(--md-sys-color-on-surface-variant);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        opacity: 0.8;
    }

    .link-url {
        color: var(--md-sys-color-primary);
        opacity: 0.7;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .link-arrow {
        --md-icon-size: 18px;
        color: var(--md-sys-color-on-surface-variant);
        opacity: 0.5;
        transition: color 0.2s, transform 0.2s;
    }

    .md3-link-card:hover .link-arrow {
        color: var(--md-sys-color-primary);
        transform: translate(2px, -2px);
        opacity: 1;
    }
</style>
