---
import "@material/web/icon/icon.js";
import { sanitizeLinkUrl } from "../../utils/security";

interface Props {
  tag: string;
  url?: string;
  color?: "default" | "primary" | "secondary" | "tertiary" | "error";
  icon?: string;
}

const { tag, url = "#", color = "default", icon = "tag" } = Astro.props;
const safeUrl = sanitizeLinkUrl(url, { allowHttp: false });
---

{
  safeUrl && (
    <a href={safeUrl} class={`md3-hashtag tone-${color}`} aria-label={`#${tag}`}>
      <md-icon class="hashtag-icon" aria-hidden="true">{icon}</md-icon>
      <span class="hashtag-label label-medium">{tag}</span>
      <md-ripple></md-ripple>
    </a>
  )
}

<script>
  import "@material/web/ripple/ripple.js";
</script>

<style>
  .md3-hashtag {
    --hashtag-container: var(--md-sys-color-surface-container-high);
    --hashtag-on-container: var(--md-sys-color-on-surface-variant);
    position: relative;
    display: inline-flex;
    min-height: var(--md-sys-touch-target-size);
    align-items: center;
    gap: 7px;
    margin: 4px 2px;
    padding: 0 14px;
    overflow: hidden;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--hashtag-container);
    color: var(--hashtag-on-container);
    vertical-align: middle;
    transition:
      border-color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      box-shadow var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
  }

  .hashtag-icon,
  .hashtag-label {
    position: relative;
    z-index: 1;
  }

  .hashtag-icon {
    width: 18px;
    height: 18px;
    font-size: 18px;
  }

  .hashtag-label {
    font-weight: 650;
  }

  .md3-hashtag:focus-visible {
    outline: var(--md-sys-focus-ring-width) solid var(--md-sys-focus-ring-color);
    outline-offset: var(--md-sys-focus-ring-offset);
  }

  .tone-primary {
    --hashtag-container: var(--md-sys-color-primary-container);
    --hashtag-on-container: var(--md-sys-color-on-primary-container);
  }

  .tone-secondary {
    --hashtag-container: var(--md-sys-color-secondary-container);
    --hashtag-on-container: var(--md-sys-color-on-secondary-container);
  }

  .tone-tertiary {
    --hashtag-container: var(--md-sys-color-tertiary-container);
    --hashtag-on-container: var(--md-sys-color-on-tertiary-container);
  }

  .tone-error {
    --hashtag-container: var(--md-sys-color-error-container);
    --hashtag-on-container: var(--md-sys-color-on-error-container);
  }

  md-ripple {
    border-radius: inherit;
    --md-ripple-hover-color: var(--hashtag-on-container);
    --md-ripple-pressed-color: var(--hashtag-on-container);
  }

  @media (hover: hover) {
    .md3-hashtag:hover {
      border-color: color-mix(in srgb, var(--hashtag-on-container) 42%, transparent);
      box-shadow: var(--md-sys-elevation-level1);
    }
  }
</style>
