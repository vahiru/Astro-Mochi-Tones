---
import "@material/web/icon/icon.js";

interface Props {
    tag: string;
    url?: string;
    color?:
        | "default"
        | "primary"
        | "secondary"
        | "tertiary"
        | "error";
    icon?: string;
}

const { tag, url = "#", color = "default", icon = "tag" } = Astro.props;

const colorClass = `color-${color}`;
---

<a href={url} class={`md3-hashtag ${colorClass}`}>
    <div class="hashtag-container">
        <md-icon class="hashtag-icon">{icon}</md-icon>
        <span class="hashtag-label label-medium">{tag}</span>
        <md-ripple></md-ripple>
    </div>
</a>

<script>
    import "@material/web/ripple/ripple.js";
</script>

<style>
    .md3-hashtag {
        display: inline-block;
        text-decoration: none;
        margin: 4px 2px;
        vertical-align: middle;
    }

    .hashtag-container {
        position: relative;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0 12px;
        height: 32px;
        border-radius: 8px; /* MD3 Assist/Filter chip style */
        background-color: var(--hashtag-bg, var(--md-sys-color-surface-container-high));
        color: var(--hashtag-text, var(--md-sys-color-on-surface-variant));
        border: 1px solid var(--md-sys-color-outline-variant);
        transition: background-color 0.2s, box-shadow 0.2s;
        overflow: hidden;
    }

    .md3-hashtag:hover .hashtag-container {
        background-color: var(--md-sys-color-surface-variant);
        box-shadow: var(--md-sys-elevation-level1);
    }

    .hashtag-icon {
        --md-icon-size: 18px;
        opacity: 0.8;
    }

    .hashtag-label {
        font-weight: 500;
        line-height: 1;
    }

    /* === 颜色变体 === */
    .color-primary {
        --hashtag-bg: var(--md-sys-color-primary-container);
        --hashtag-text: var(--md-sys-color-on-primary-container);
    }
    .color-secondary {
        --hashtag-bg: var(--md-sys-color-secondary-container);
        --hashtag-text: var(--md-sys-color-on-secondary-container);
    }
    .color-tertiary {
        --hashtag-bg: var(--md-sys-color-tertiary-container);
        --hashtag-text: var(--md-sys-color-on-tertiary-container);
    }
    .color-error {
        --hashtag-bg: var(--md-sys-color-error-container);
        --hashtag-text: var(--md-sys-color-on-error-container);
    }

    md-ripple {
        --md-ripple-hover-color: var(--md-sys-color-on-surface);
        --md-ripple-pressed-color: var(--md-sys-color-primary);
    }
</style>
