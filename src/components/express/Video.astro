---
import { sanitizeAssetUrl, sanitizeCssLength } from "../../utils/security";

interface Props {
  src?: string;
  bilibili?: string;
  youtube?: string;
  width?: string;
  autoplay?: boolean;
}

const { src, bilibili, youtube, width = "100%", autoplay = false } = Astro.props;
const safeWidth = sanitizeCssLength(width) ?? "100%";
const safeBilibili = bilibili && /^[A-Za-z0-9]+$/.test(bilibili) ? bilibili : "";
const safeYoutube = youtube && /^[A-Za-z0-9_-]{6,20}$/.test(youtube) ? youtube : "";
const directSrc = sanitizeAssetUrl(src) ?? "";

let embedSrc = "";
let embedTitle = "嵌入式视频播放器";
if (safeBilibili) {
  embedSrc = `https://player.bilibili.com/player.html?bvid=${safeBilibili}&page=1&high_quality=1&autoplay=${autoplay ? 1 : 0}`;
  embedTitle = "哔哩哔哩视频播放器";
} else if (safeYoutube) {
  embedSrc = `https://www.youtube-nocookie.com/embed/${safeYoutube}?autoplay=${autoplay ? 1 : 0}`;
  embedTitle = "YouTube 视频播放器";
}
const style = `--video-width: ${safeWidth}`;
---

{
  directSrc ? (
    <div class="video-shell direct" style={style}>
      <video
        src={directSrc}
        controls
        autoplay={autoplay}
        muted={autoplay}
        playsinline
        preload="metadata"
        class="express-video"
      >
        Your browser does not support the video tag.
      </video>
    </div>
  ) : embedSrc ? (
    <div class="video-shell embed" style={style}>
      <iframe
        src={embedSrc}
        title={embedTitle}
        allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
        sandbox="allow-scripts allow-same-origin allow-presentation"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
        loading="lazy"
      />
    </div>
  ) : null
}

<style>
  .video-shell {
    width: var(--video-width);
    max-width: 100%;
    margin: 28px auto;
    overflow: hidden;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    background: var(--md-sys-color-scrim);
    box-shadow: var(--md-sys-elevation-level1);
  }

  .video-shell.embed { aspect-ratio: 16 / 9; }

  .express-video,
  .video-shell iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--md-sys-color-scrim);
  }

  .express-video { max-height: min(78dvh, 720px); }

  .video-shell iframe:focus-visible,
  .express-video:focus-visible {
    outline: var(--md-sys-focus-ring-width) solid var(--md-sys-focus-ring-color);
    outline-offset: calc(-1 * var(--md-sys-focus-ring-width));
  }

  @media (max-width: 599px) {
    .video-shell { border-radius: var(--md-sys-shape-corner-large); }
  }
</style>
