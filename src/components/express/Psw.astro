---
interface Props {
  title?: string;
}

const { title = "点击显示内容" } = Astro.props;
---

<button class="md3-psw" type="button" aria-pressed="false" aria-label={title} title={title}>
  <span class="psw-content"><slot /></span>
  <md-ripple></md-ripple>
</button>

<script>
  import "@material/web/ripple/ripple.js";

  const bindSpoilers = () => {
    document.querySelectorAll<HTMLButtonElement>(".md3-psw").forEach((button) => {
      if (button.dataset.spoilerBound === "true") return;
      button.dataset.spoilerBound = "true";
      button.addEventListener("click", () => {
        const revealed = button.getAttribute("aria-pressed") === "true";
        button.setAttribute("aria-pressed", String(!revealed));
      });
    });
  };

  bindSpoilers();
  document.addEventListener("astro:after-swap", bindSpoilers);
</script>

<style>
  .md3-psw {
    position: relative;
    display: inline-grid;
    min-width: var(--md-sys-touch-target-size);
    min-height: 32px;
    place-items: center;
    margin-inline: 2px;
    padding: 0 8px;
    overflow: hidden;
    border-radius: var(--md-sys-shape-corner-extra-small);
    background: var(--md-sys-color-on-surface);
    color: transparent;
    font: inherit;
    line-height: inherit;
    cursor: pointer;
    vertical-align: -0.45em;
    transition:
      background-color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
    user-select: none;
  }

  .md3-psw::before {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: calc(100% + 16px);
    min-width: var(--md-sys-touch-target-size);
    height: var(--md-sys-touch-target-size);
    content: "";
    translate: -50% -50%;
  }

  .psw-content {
    position: relative;
    z-index: 1;
  }

  .md3-psw[aria-pressed="true"] {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    user-select: text;
  }

  .md3-psw:focus-visible {
    outline: var(--md-sys-focus-ring-width) solid var(--md-sys-focus-ring-color);
    outline-offset: var(--md-sys-focus-ring-offset);
  }

  md-ripple {
    border-radius: inherit;
    --md-ripple-hover-color: var(--md-sys-color-inverse-on-surface);
    --md-ripple-pressed-color: var(--md-sys-color-primary);
  }

  @media (hover: hover) {
    .md3-psw:hover:not([aria-pressed="true"]) {
      background: color-mix(in srgb, var(--md-sys-color-on-surface) 86%, var(--md-sys-color-surface));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .md3-psw { transition: none; }
  }
</style>
