---
interface Props {
  color?: "default" | "primary" | "secondary" | "tertiary" | "error" | "success" | "info" | "warning";
  label?: string;
}

const { color = "default", label } = Astro.props;
---

<mark class={`md3-mark tone-${color}`}><slot>{label}</slot></mark>

<style>
  .md3-mark {
    --mark-container: var(--md-sys-color-secondary-container);
    --mark-on-container: var(--md-sys-color-on-secondary-container);
    padding: 0.1em 0.34em;
    border-radius: var(--md-sys-shape-corner-extra-small);
    background: var(--mark-container);
    color: var(--mark-on-container);
    font-weight: 600;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .tone-primary {
    --mark-container: var(--md-sys-color-primary-container);
    --mark-on-container: var(--md-sys-color-on-primary-container);
  }

  .tone-secondary {
    --mark-container: var(--md-sys-color-secondary-container);
    --mark-on-container: var(--md-sys-color-on-secondary-container);
  }

  .tone-tertiary {
    --mark-container: var(--md-sys-color-tertiary-container);
    --mark-on-container: var(--md-sys-color-on-tertiary-container);
  }

  .tone-error {
    --mark-container: var(--md-sys-color-error-container);
    --mark-on-container: var(--md-sys-color-on-error-container);
  }

  .tone-success {
    --mark-container: var(--md-extended-color-success-container);
    --mark-on-container: var(--md-extended-color-on-success-container);
  }

  .tone-info {
    --mark-container: var(--md-extended-color-info-container);
    --mark-on-container: var(--md-extended-color-on-info-container);
  }

  .tone-warning {
    --mark-container: var(--md-extended-color-warning-container);
    --mark-on-container: var(--md-extended-color-on-warning-container);
  }
</style>
