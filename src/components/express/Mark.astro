---
interface Props {
    color?:
        | "default"
        | "primary"
        | "secondary"
        | "tertiary"
        | "error"
        | "success"
        | "info"
        | "warning";
    label?: string;
}

const { color = "default", label } = Astro.props;
const colorClass = `color-${color}`;
---

<mark class={`md3-mark ${colorClass}`}>
    <slot>{label}</slot>
</mark>

<style>
    .md3-mark {
        display: inline;
        padding: 0.1em 0.3em;
        border-radius: 6px;
        background-color: var(--mark-bg, var(--md-sys-color-secondary-container));
        color: var(--mark-text, var(--md-sys-color-on-secondary-container));
        font-weight: 500;
        transition: background-color 0.3s;
        box-decoration-break: clone;
        -webkit-box-decoration-break: clone;
    }

    /* === 颜色映射 === */
    .color-primary {
        --mark-bg: var(--md-sys-color-primary-container);
        --mark-text: var(--md-sys-color-on-primary-container);
    }
    .color-tertiary {
        --mark-bg: var(--md-sys-color-tertiary-container);
        --mark-text: var(--md-sys-color-on-tertiary-container);
    }
    .color-error {
        --mark-bg: var(--md-sys-color-error-container);
        --mark-text: var(--md-sys-color-on-error-container);
    }
    
    .color-success {
        --mark-bg: #e8f5e9;
        --mark-text: #1b5e20;
    }
    :global(.dark) .color-success {
        --mark-bg: rgba(27, 94, 32, 0.4);
        --mark-text: #e8f5e9;
    }

    .color-info {
        --mark-bg: #e3f2fd;
        --mark-text: #0d47a1;
    }
    :global(.dark) .color-info {
        --mark-bg: rgba(13, 71, 161, 0.4);
        --mark-text: #e3f2fd;
    }

    .color-warning {
        --mark-bg: #fff8e1;
        --mark-text: #795548;
    }
    :global(.dark) .color-warning {
        --mark-bg: rgba(245, 127, 23, 0.3);
        --mark-text: #ffe082;
    }
</style>
