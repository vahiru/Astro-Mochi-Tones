---
interface Props {
  title?: string;
  author?: string;
}

const { title, author } = Astro.props;
---

<section class="md3-poetry" aria-label={title}>
  <md-icon class="poetry-decoration top" aria-hidden="true">format_quote</md-icon>
  {
    (title || author) && (
      <header class="poetry-header">
        {title && <div class="poetry-title headline-small">{title}</div>}
        {author && <div class="poetry-author label-large">{author}</div>}
      </header>
    )
  }
  <div class="poetry-content body-large"><slot /></div>
  <md-icon class="poetry-decoration bottom" aria-hidden="true">format_quote</md-icon>
</section>

<script>
  import "@material/web/icon/icon.js";
</script>

<style>
  .md3-poetry {
    position: relative;
    width: min(100%, 680px);
    margin: 40px auto;
    overflow: hidden;
    padding: clamp(36px, 7vw, 64px);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-extra-large) var(--md-sys-shape-corner-extra-large) var(--md-sys-shape-corner-extra-extra-large) var(--md-sys-shape-corner-extra-large);
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
    box-shadow: var(--md-sys-elevation-level1);
    text-align: center;
  }

  .poetry-decoration {
    position: absolute;
    width: 64px;
    height: 64px;
    color: var(--md-sys-color-tertiary);
    font-size: 64px;
    opacity: 0.16;
    pointer-events: none;
  }

  .poetry-decoration.top { top: 18px; left: 20px; }
  .poetry-decoration.bottom { right: 20px; bottom: 18px; rotate: 180deg; }

  .poetry-header {
    position: relative;
    z-index: 1;
    margin-bottom: 28px;
  }

  .poetry-header::after {
    display: block;
    width: 48px;
    height: 4px;
    margin: 18px auto 0;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-tertiary);
    content: "";
  }

  .poetry-title {
    color: inherit;
    font-family: var(--md-ref-typeface-brand);
    font-weight: 600;
  }

  .poetry-author {
    margin-top: 6px;
    color: inherit;
    font-style: italic;
    opacity: 0.72;
  }

  .poetry-content {
    position: relative;
    z-index: 1;
    color: inherit;
    font-family: "Noto Serif SC", "Songti SC", Georgia, serif;
    font-style: italic;
    line-height: 2.15;
    white-space: pre-wrap;
  }

  .poetry-content :global(> :first-child) { margin-top: 0; }
  .poetry-content :global(> :last-child) { margin-bottom: 0; }

  @media (max-width: 599px) {
    .md3-poetry {
      margin-block: 28px;
      padding: 40px 22px;
      border-radius: var(--md-sys-shape-corner-extra-large);
    }

    .poetry-decoration { width: 44px; height: 44px; font-size: 44px; }
  }
</style>
