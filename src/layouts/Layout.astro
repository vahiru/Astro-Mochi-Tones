---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import NavRail from "../components/NavRail.astro";
import SearchWidget from "../components/SearchWidget.astro";
import themeConfig from "astro-mochi-tones:config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: Date;
}

const {
  title = themeConfig.title,
  description = themeConfig.description ?? "",
  image = themeConfig.defaultImage,
  articleDate,
} = Astro.props;

const siteTitle = themeConfig.title;
const pageTitle = title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang={themeConfig.lang}>
  <head>
    <BaseHead
      title={pageTitle}
      description={description}
      image={image}
      articleDate={articleDate}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteTitle} RSS Feed`}
      href={themeConfig.rssPath}
    />

    <script is:inline>
      // 必须在首次绘制前同步执行：先定明暗，再套用用户自定义配色的缓存变量，
      // 否则会先闪一下默认配色。缓存由 ColorPicker 写入，这里只读、不引入任何算法库。
      (() => {
        let preference = null;
        try {
          preference = localStorage.getItem("theme");
        } catch {
          preference = null;
        }

        const useDark = preference === "dark" || (
          preference !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches
        );
        const root = document.documentElement;
        root.classList.toggle("dark", useDark);

        try {
          const raw = localStorage.getItem("source-color-vars");
          if (!raw) return;
          const vars = JSON.parse(raw)?.[useDark ? "dark" : "light"];
          if (!vars || typeof vars !== "object") return;

          // localStorage 可被页面内任意脚本改写，写进 style 前逐条校验格式。
          for (const [token, value] of Object.entries(vars)) {
            if (/^--md-sys-color-[a-z-]+$/.test(token) && /^#[0-9a-f]{6}$/i.test(value)) {
              root.style.setProperty(token, value);
            }
          }
        } catch {
          // 缓存损坏时退回默认配色，ColorPicker 稍后会重新算一份。
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>

    <header class="compact-top-app-bar">
      <a class="compact-brand" href="/" aria-label={`${siteTitle} 首页`}>
        <span class="brand-mark" aria-hidden="true">V</span>
        <span class="header-title">{title}</span>
      </a>
      <div class="top-app-bar-actions">
        <button
          class="icon-button"
          type="button"
          data-open-theme-picker
          aria-label={themeConfig.nav.colorLabel}
          title={themeConfig.nav.colorLabel}
        >
          <md-icon>{themeConfig.nav.colorIcon}</md-icon>
        </button>
        <button
          class="icon-button"
          type="button"
          data-theme-toggle
          data-dark-icon={themeConfig.nav.darkIcon}
          data-light-icon={themeConfig.nav.lightIcon}
          aria-label={themeConfig.nav.themeLabel}
          title={themeConfig.nav.themeLabel}
        >
          <md-icon class="theme-icon">{themeConfig.nav.darkIcon}</md-icon>
        </button>
        <button
          class="icon-button search-trigger"
          type="button"
          aria-label={themeConfig.labels.search}
          title={themeConfig.labels.search}
        >
          <md-icon>search</md-icon>
        </button>
      </div>
    </header>

    <div class="app-layout">
      <NavRail />
      <main id="main-content" class="main-content" tabindex="-1">
        <div class="content-inner">
          <slot />
        </div>
        <Footer />
      </main>
    </div>

    <SearchWidget />

    <script>
      import "@material/web/button/elevated-button.js";
      import "@material/web/button/filled-tonal-button.js";
      import "@material/web/button/text-button.js";
      import "@material/web/divider/divider.js";
      import "@material/web/icon/icon.js";
      import "@material/web/ripple/ripple.js";

      const bindSearchTriggers = () => {
        document.querySelectorAll<HTMLButtonElement>(".search-trigger, .search-fab").forEach((button) => {
          if (button.dataset.searchBound === "true") return;
          button.dataset.searchBound = "true";
          button.addEventListener("click", () => {
            window.dispatchEvent(new Event("open-search"));
          });
        });
      };

      bindSearchTriggers();
      document.addEventListener("astro:after-swap", bindSearchTriggers);
    </script>
  </body>
</html>

<style>
  .app-layout {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    width: 100%;
    height: 100dvh;
    padding: 8px 8px 8px 0;
    background: var(--md-sys-color-surface-container);
  }

  .main-content {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    border-radius: var(--md-sys-shape-corner-extra-large);
    background: var(--md-sys-color-surface);
    color: var(--md-sys-color-on-surface);
  }

  .content-inner {
    width: 100%;
    min-width: 0;
    flex: 1;
    padding: clamp(24px, 3vw, 48px);
  }

  .compact-top-app-bar {
    display: none;
  }

  .icon-button {
    position: relative;
    display: inline-flex;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--md-sys-shape-corner-full);
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    transition:
      background-color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects),
      color var(--md-sys-motion-duration-fast) var(--md-sys-motion-easing-effects);
  }

  .icon-button:hover {
    background: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
    color: var(--md-sys-color-on-surface);
  }

  @media (max-width: 599px) {
    .compact-top-app-bar {
      position: fixed;
      inset: 0 0 auto;
      z-index: 900;
      display: flex;
      height: var(--top-app-bar-height);
      align-items: center;
      justify-content: space-between;
      gap: 4px;
      padding: 8px max(8px, env(safe-area-inset-right)) 8px max(12px, env(safe-area-inset-left));
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
      background: color-mix(in srgb, var(--md-sys-color-surface) 92%, transparent);
      backdrop-filter: blur(18px);
    }

    .compact-brand {
      display: flex;
      min-width: 0;
      flex: 1;
      align-items: center;
      gap: 10px;
      border-radius: var(--md-sys-shape-corner-full);
    }

    .brand-mark {
      display: grid;
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      place-items: center;
      border-radius: var(--md-sys-shape-corner-medium);
      background: var(--md-sys-color-primary-container);
      color: var(--md-sys-color-on-primary-container);
      font-family: var(--md-ref-typeface-brand);
      font-size: 20px;
      font-weight: 700;
    }

    .header-title {
      min-width: 0;
      overflow: hidden;
      color: var(--md-sys-color-on-surface);
      font-size: var(--md-sys-typescale-title-medium-size);
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .top-app-bar-actions {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
    }

    .app-layout {
      display: block;
      height: auto;
      min-height: 100dvh;
      padding: 0;
      background: var(--md-sys-color-surface);
    }

    .main-content {
      min-height: 100dvh;
      overflow: visible;
      border-radius: 0;
      padding-block: var(--top-app-bar-height) calc(var(--bottom-nav-height) + env(safe-area-inset-bottom));
    }

    .content-inner {
      padding: 16px;
    }
  }

  @media (max-width: 380px) {
    .brand-mark {
      display: none;
    }
  }

  @media (min-width: 600px) and (max-width: 839px) {
    .content-inner {
      padding: 24px;
    }
  }
</style>
